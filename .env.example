# AI Provider Selection
# Accepted values: gemini | local
# "local" is a placeholder — it will refuse sessions until Phase 4 (Ollama) is implemented.
AI_PROVIDER=gemini

# Gemini API Key — required when AI_PROVIDER=gemini.
# Keep this exclusively on the backend. It is never forwarded to the frontend.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted (used for OAuth callbacks, self-referential links).
APP_URL="MY_APP_URL"

# Optional: override the HTTP/WS listen port (default: 3000)
# PORT=3000

# --- Phase 1 phone remote control (Electron mode only) ---
# The phone dashboard is served at /remote and the authenticated phone socket
# at /remote/ws. It is enabled only when running under Electron and a per-run
# desktop token exists.
#
# Strict boolean: 1/0, true/false, yes/no, on/off. Unset = enabled in Electron.
# Any other value is rejected and remote control stays DISABLED.
# MYRA_REMOTE=1

# Pairing rate limiting uses the direct socket address. When Myra is reached
# through a local reverse proxy such as Tailscale Serve, every request appears
# to come from 127.0.0.1. Set MYRA_TRUST_PROXY=1 ONLY when that proxy is the
# sole ingress and rewrites/appends X-Forwarded-For; Myra then uses the
# right-most valid forwarded address. Never enable it on a directly exposed
# server.
# MYRA_TRUST_PROXY=1

# Public HTTPS origin of the phone dashboard (for example a Tailscale Serve
# URL). The pairing panel shows this URL to the phone. If only an origin is
# given, /remote is appended. See docs/REMOTE_CONTROL.md.
# MYRA_REMOTE_PUBLIC_URL=https://myra-pc.example-tailnet.ts.net

# --- Project Intelligence + Interview Mode (Phase: interview) ---
# Enabled by default. MYRA_INTELLIGENCE=0 disables the /api/intelligence
# surface entirely (the Interview panel then reports it is unavailable).
# MYRA_INTELLIGENCE=1

# Where analysed projects, interview sessions and reports are stored (JSON).
# Defaults to ./.myra-data (Electron overrides it to the app's userData dir).
# MYRA_DATA_DIR=E:\PERSONAL_AI_2\Myra_AI_Gemini\.myra-data

# Gemini text model used for project analysis and interview questions.
# MYRA_INTELLIGENCE_MODEL=gemini-3.8-flash

# Maximum Gemini requests per Project Analysis run and per interview session.
# Quota/429 errors stop the run immediately; no retry or chunk splitting.
# MYRA_INTELLIGENCE_REQUEST_CAP=40

# Electron sets this automatically: folder roots approved by the native picker.
# In Electron mode Myra refuses to scan a local folder that is not in this list.
# MYRA_APPROVED_PROJECTS_FILE=C:\Users\<you>\AppData\Roaming\myra\approved-project-roots.json
