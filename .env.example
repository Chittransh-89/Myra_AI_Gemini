# AI Provider Selection
# Accepted values: gemini | local
# "local" is a placeholder — it will refuse sessions until Phase 4 (Ollama) is implemented.
AI_PROVIDER=gemini

# Gemini API Key — required when AI_PROVIDER=gemini.
# Keep this exclusively on the backend. It is never forwarded to the frontend.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted (used for OAuth callbacks, self-referential links).
APP_URL="MY_APP_URL"

# Optional: override the HTTP/WS listen port (default: 3000)
# PORT=3000
